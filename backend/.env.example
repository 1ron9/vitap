# Dành cho backend chạy thủ công; Docker Compose dùng .env ở thư mục gốc.
# Cấu hình Supabase (PostgreSQL); thay các placeholder trước khi chạy.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Cấu hình Secret JWT
SECRET_KEY=change_this_to_a_super_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình Gemini API (Lấy miễn phí tại aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
USE_MOCK_AI=True

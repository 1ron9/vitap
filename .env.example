# Chỉ dành cho môi trường local; không dùng thông tin mẫu để triển khai public.
POSTGRES_DB=vitap
POSTGRES_USER=vitap
POSTGRES_PASSWORD=vitap_local_dev
POSTGRES_PUBLISH_PORT=5432
BACKEND_PORT=8000
SECRET_KEY=local_development_only_replace_before_deployment
USE_MOCK_AI=true
OCR_MODE=printed
OCR_LANG=vi
OCR_PADDLE_DEVICE=cpu
OCR_TIMEOUT_SECONDS=180
GEMINI_VISION_MODEL=gemini-3.8-flash
# M3 runs offline with USE_MOCK_AI=true. Fill in providers for real M3 requests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=
RERANKER_URL=
KAGGLE_MEDGEMMA_NGROK_URL=
EMBEDDING_MODEL=nomic-embed-text-v2-moe

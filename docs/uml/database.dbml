// ====================================================================
// DATABASE MARKUP LANGUAGE (DBML) - VITAP PROJECT
// Sử dụng: Truy cập https://dbdiagram.io và dán toàn bộ mã này vào để sinh ERD tương tác
// ====================================================================

Table users {
  id integer [pk, increment, note: 'Khóa chính tự tăng']
  phone varchar(15) [unique, not null, note: 'Số điện thoại đăng nhập']
  hashed_password varchar(255) [not null, note: 'Mật khẩu Bcrypt']
  full_name varchar(100, note: 'Họ và tên hiển thị']
  created_at timestamp [default: `now()`, note: 'Thời điểm tạo tài khoản']
}

Table patient_profiles {
  id integer [pk, increment]
  user_id integer [unique, not null, note: 'Quan hệ 1-1 với users']
  yob integer [note: 'Năm sinh tính tuổi']
  gender varchar(10) [default: 'OTHER', note: 'MALE, FEMALE, OTHER']
  medical_conditions text [default: '[]', note: 'JSON array ICD-10']
  drug_allergies text [default: '[]', note: 'JSON array dị ứng hoạt chất']
  updated_at timestamp
}

Table active_ingredients {
  id integer [pk, increment, note: 'Định danh hoạt chất gốc']
  inn_name varchar(255) [unique, not null, note: 'Tên INN quốc tế: Paracetamol, Ibuprofen...']
  atc_code varchar(10, note: 'Mã phân loại ATC']
  drug_class varchar(100, note: 'Nhóm dược lý: NSAID, ACEI, Statin...']
}

Table brand_names {
  id integer [pk, increment, note: 'Định danh biệt dược']
  brand_name varchar(255) [not null, note: 'Tên biệt dược thương mại: Panadol, Hapacol...']
  manufacturer varchar(255, note: 'Hãng sản xuất: DHG, Sanofi...']
  dosage_form varchar(50, note: 'Dạng bào chế: Viên nén, Viên sủi...']
}

Table drug_ingredients {
  brand_id integer [not null, note: 'Biệt dược']
  ingredient_id integer [not null, note: 'Hoạt chất']
  strength varchar(50, note: 'Hàm lượng: 500mg, 65mg...']

  indexes {
    (brand_id, ingredient_id) [pk]
  }
}

Table conditions {
  id integer [pk, increment, note: 'Định danh bệnh nền']
  icd10_code varchar(10) [unique, not null, note: 'Mã ICD-10: I10, K25, Z33...']
  condition_name varchar(255) [not null, note: 'Tên bệnh nền tiếng Việt']
}

Table drug_drug_interactions {
  id integer [pk, increment]
  ingredient_a_id integer [not null, note: 'Ràng buộc Canonical Pair: A < B']
  ingredient_b_id integer [not null]
  severity varchar(10) [not null, note: 'RED, YELLOW, GREEN']
  mechanism text [not null, note: 'Cơ chế dược lực / dược động học']
  clinical_management text [not null, note: 'Khuyến cáo xử trí y khoa']
}

Table drug_condition_interactions {
  id integer [pk, increment]
  ingredient_id integer [not null, note: 'Hoạt chất gây bất lợi']
  condition_id integer [not null, note: 'Bệnh nền chống chỉ định']
  severity varchar(10) [not null, note: 'RED (Nguy hiểm) / YELLOW (Thận trọng)']
  contraindication_type varchar(20) [default: 'ABSOLUTE', note: 'ABSOLUTE / RELATIVE']
  clinical_advice text [not null, note: 'Lời khuyên lâm sàng']
}

Table user_cabinets {
  id integer [pk, increment, note: 'Định danh thuốc trong tủ']
  user_id integer [not null, note: 'Chủ sở hữu tủ thuốc']
  brand_id integer [note: 'Biệt dược chuẩn trong CSDL (nếu có)']
  custom_drug_name varchar(255, note: 'Tên thuốc tự nhập']
  total_quantity integer [default: 0, note: 'Tổng số lượng']
  remaining_quantity integer [default: 0, note: 'Số lượng còn lại']
  expiry_date date [note: 'Hạn dùng']
}

Table medication_schedules {
  id integer [pk, increment, note: 'Định danh cữ uống']
  cabinet_id integer [not null, note: 'Thuốc trong tủ']
  session varchar(20) [not null, note: 'MORNING, NOON, EVENING']
  scheduled_time varchar(5) [not null, note: 'Giờ uống HH:MM']
  dosage float [default: 1.0, note: 'Liều lượng']
  is_active boolean [default: true, note: 'Bật/Tắt nhắc nhở']
}

// ====================================================================
// QUAN HỆ & LIÊN KẾT KHÓA NGOẠI (FOREIGN KEYS)
// ====================================================================

Ref: patient_profiles.user_id - users.id
Ref: user_cabinets.user_id > users.id
Ref: user_cabinets.brand_id > brand_names.id
Ref: medication_schedules.cabinet_id > user_cabinets.id

Ref: drug_ingredients.brand_id > brand_names.id
Ref: drug_ingredients.ingredient_id > active_ingredients.id

Ref: drug_drug_interactions.ingredient_a_id > active_ingredients.id
Ref: drug_drug_interactions.ingredient_b_id > active_ingredients.id

Ref: drug_condition_interactions.ingredient_id > active_ingredients.id
Ref: drug_condition_interactions.condition_id > conditions.id
